doctype html
html(lang='en')
  head
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    meta(name='description', content='Loc8r helps you find places to work with wifi near you.')
    title= title
    link(rel='preconnect', href='https://fonts.googleapis.com')
    link(rel='preconnect', href='https://fonts.gstatic.com', crossorigin)
    link(rel='stylesheet', href='https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap')
    link(rel='stylesheet', href='/bootstrap/css/bootstrap.min.css')
    link(rel='stylesheet', href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css')
    link(rel='stylesheet', href='/stylesheets/style.css')
  body
    nav.navbar.fixed-top.navbar-expand-md.navbar-dark
      .container
        a.navbar-brand(href='/')
          i.fas.fa-map-marker-alt.me-2
          | Loc8r
        button.navbar-toggler(type='button', data-bs-toggle='collapse', data-bs-target='#navbarMain', aria-controls='navbarMain', aria-expanded='false', aria-label='Toggle navigation')
          span.navbar-toggler-icon
        #navbarMain.navbar-collapse.collapse
          ul.navbar-nav.ms-auto
            li.nav-item
              a.nav-link(href='/', class=currentPath === '/' ? 'active' : '') Home
            li.nav-item
              a.nav-link(href='/about', class=currentPath === '/about' ? 'active' : '') About
    main.container.content
      block content
    footer.site-footer
      .container
        small &copy; Getting MEAN Simon Holmes/ Clive Harber 2018
    script(src='/bootstrap/js/bootstrap.bundle.min.js')
