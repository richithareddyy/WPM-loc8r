extends layout
include _includes/sharedHTMLfunctions
block content
  .row.banner
    .col-12
      h1= pageHeader.title
  .row
    .col-12.col-lg-9
      .row
        .col-12.col-md-6
          +outputRating(location.rating)
          p.address
            i.fas.fa-map-pin.me-2
            = location.address
          .card
            .card-body
              h2.card-title
                i.far.fa-clock.me-2
                | Opening hours
              each time in location.openingTimes
                p.card-text.opening-time
                  span= time.days
                  if time.closed
                    span.text-muted closed
                  else
                    span #{time.opening} - #{time.closing}
          .card
            .card-body
              h2.card-title
                i.fas.fa-concierge-bell.me-2
                | Facilities
              each facility in location.facilities
                span.badge.facility
                  i.fas.fa-check.me-1
                  = facility
        .col-12.col-md-6.location-map
          .card
            .card-body
              h2.card-title
                i.far.fa-map.me-2
                | Location map
              - const { lat, lng } = location.coords;
              - const bbox = [lng - 0.004, lat - 0.0015, lng + 0.004, lat + 0.0015].join('%2C');
              iframe.map(loading='lazy', title=`Map showing ${location.name}`, src=`https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${lat}%2C${lng}`)
      .row
        .col-12
          .card.review-card
            .card-body
              .d-flex.justify-content-between.align-items-center.mb-2
                h2.card-title.mb-0
                  i.far.fa-comments.me-2
                  | Customer reviews
                a.btn.btn-primary(href='/locations/review/new')
                  i.fas.fa-pen.me-2
                  | Add review
              each review in location.reviews
                .review
                  .review-header
                    +outputRating(review.rating)
                    span.review-author= review.author
                    small.review-timestamp
                      +formatDate(review.timestamp)
                  p.review-text= review.reviewText
    .col-12.col-lg-3
      aside.sidebar
        p.lead #{location.name} #{sidebar.context}
        p= sidebar.callToAction
