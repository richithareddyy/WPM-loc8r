extends layout
block content
  .row.banner
    .col-12
      h1= pageHeader.title
  .row
    .col-12.col-md-8
      .card
        .card-body
          form(action='/locations', method='get')
            .mb-3.row
              label.col-sm-2.col-form-label(for='name') Name
              .col-sm-10
                input#name.form-control(name='name', required, maxlength='60', autocomplete='name')
            .mb-3.row
              label.col-sm-2.col-form-label(for='rating') Rating
              .col-sm-4
                select#rating.form-select(name='rating', required)
                  option(value='5') 5 - Excellent
                  option(value='4') 4 - Good
                  option(value='3') 3 - Average
                  option(value='2') 2 - Poor
                  option(value='1') 1 - Terrible
            .mb-3.row
              label.col-sm-2.col-form-label(for='review') Review
              .col-sm-10
                textarea#review.form-control(name='review', rows='5', required, maxlength='1000', placeholder='What was it like to work there?')
            .d-flex.justify-content-end.gap-2
              a.btn.btn-outline-secondary(href='/locations') Cancel
              button.btn.btn-primary(type='submit') Add my review
    .col-12.col-md-4
      aside.sidebar
        p Reviews help other people find good places to work. Please keep it honest and friendly.
